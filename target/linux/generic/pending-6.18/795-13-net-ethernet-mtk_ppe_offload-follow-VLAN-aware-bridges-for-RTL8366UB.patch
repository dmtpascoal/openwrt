From: Diogo Pascoal <dmtpascoal@gmail.com>
Subject: [PATCH] net: ethernet: mtk_ppe_offload: follow VLAN-aware bridges for
 the RTL8366UB 802.1Q tagger

For an RTL8366UB user port in a bridge, mtk_flow_get_dsa_port() always
pushed the tag_8021q bridge VID. That matches the tagger's xmit only for
VLAN-unaware bridges. With VLAN filtering, the tagger leaves the frame alone
and, because the port uses TX forwarding offload, the bridge keeps the real
bridge VLAN on it (br_handle_vlan() does not untag), so the switch forwards
by that VID and its FDB.

The PPE instead sent the bridge VID as the outer tag (in front of any VLAN
the flowtable pushes). The switch classifies on the outer tag and learns
independently per VLAN (IVL), so every hardware-offloaded frame missed the
FDB, was treated as unknown unicast and flooded to all bridge ports, or
dropped. Reported in the field as lost segments, duplicate ACKs and stalls
for WAN<->LAN flows over a VLAN trunk with hardware flow offloading on,
while software offloading works.

For VLAN-aware bridges, build the same single 802.1Q tag as the software
path: rely on the flowtable's VLAN push when the egress VLAN is tagged on
the port, and push the port's PVID when the bridge path marked the VLAN as
hardware-untagged (no push requested), provided the PVID really is the
VLAN the port sends untagged. Anything else is left to software.

Not yet verified on hardware.
---
diff --git a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
index 92dd026..2cac376 100644
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -11,6 +11,7 @@
 #include <net/pkt_cls.h>
 #include <net/dsa.h>
 #include <linux/dsa/8021q.h>
+#include <linux/if_bridge.h>
 #include "mtk_eth_soc.h"
 #include "mtk_wed.h"
 
@@ -185,7 +186,8 @@ mtk_flow_mangle_ipv4(const struct flow_action_entry *act,
  * switch below to cover them without per-tagger review.
  */
 static int
-mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
+mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid,
+		      bool *vlan_aware)
 {
 #if IS_ENABLED(CONFIG_NET_DSA)
 	struct dsa_port *dp;
@@ -207,11 +209,23 @@ mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
 		if (push_vid) {
 			struct net_device *br = dsa_port_bridge_dev_get(dp);
 
-			if (br)
+			if (br && br_vlan_enabled(br)) {
+				/* With TX forwarding offload the bridge hands
+				 * the switch frames still carrying their
+				 * bridge VLAN, and the switch forwards them by
+				 * that VID and its FDB. The tag_8021q bridge
+				 * VID would make every offloaded frame an FDB
+				 * miss (IVL), so let the caller build the same
+				 * single 802.1Q tag the software path uses.
+				 */
+				if (vlan_aware)
+					*vlan_aware = true;
+			} else if (br) {
 				*push_vid = dsa_tag_8021q_bridge_vid(
 					dsa_port_bridge_num_get(dp));
-			else
+			} else {
 				*push_vid = dsa_tag_8021q_standalone_vid(dp);
+			}
 		}
 		break;
 	default:
@@ -229,8 +243,10 @@ mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
 static int
 mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 			   struct net_device *dev, const u8 *dest_mac,
-			   int *wed_index)
+			   int num_vlans, int *wed_index)
 {
+	struct net_device *user_dev = dev;
+	bool vlan_aware = false;
 	struct mtk_wdma_info info = {};
 	struct mtk_mac *mac;
 	int pse_port, dsa_port, queue;
@@ -261,7 +277,7 @@ mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 		goto out;
 	}
 
-	dsa_port = mtk_flow_get_dsa_port(&dev, &push_vid);
+	dsa_port = mtk_flow_get_dsa_port(&dev, &push_vid, &vlan_aware);
 
 	if (dev == eth->netdev[0])
 		pse_port = PSE_GDM1_PORT;
@@ -272,7 +288,32 @@ mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 	else
 		return -EOPNOTSUPP;
 
-	if (dsa_port >= 0) {
+	if (dsa_port >= 0 && vlan_aware) {
+		/* The flowtable already pushes the egress VLAN when it is
+		 * tagged on the port. When it is untagged there, the bridge
+		 * path marks it as hardware-untagged and no push is
+		 * requested, but the switch still expects it tagged on the
+		 * CPU port: push the port's PVID, provided that is the VLAN
+		 * the port sends untagged. Anything else stays in software.
+		 */
+		if (!num_vlans) {
+			struct bridge_vlan_info vinfo = {};
+			u16 pvid;
+
+			rcu_read_lock();
+			err = br_vlan_get_pvid_rcu(user_dev, &pvid);
+			if (!err && pvid)
+				err = br_vlan_get_info_rcu(user_dev, pvid, &vinfo);
+			rcu_read_unlock();
+			if (err || !pvid ||
+			    !(vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED))
+				return -EOPNOTSUPP;
+
+			err = mtk_foe_entry_set_vlan(eth, foe, pvid);
+			if (err)
+				return err;
+		}
+	} else if (dsa_port >= 0) {
 		if (push_vid) {
 			err = mtk_foe_entry_set_vlan(eth, foe, push_vid);
 			if (err)
@@ -352,7 +393,7 @@ mtk_flow_offload_replace(struct mtk_eth *eth, struct flow_cls_offload *f,
 			 * ppe[mac->ppe_idx]; the lookup misses and the
 			 * flow never binds in HW.
 			 */
-			mtk_flow_get_dsa_port(&idev, NULL);
+			mtk_flow_get_dsa_port(&idev, NULL, NULL);
 			if (mtk_flow_is_valid_idev(eth, idev)) {
 				struct mtk_mac *mac = netdev_priv(idev);
 
@@ -536,7 +577,7 @@ mtk_flow_offload_replace(struct mtk_eth *eth, struct flow_cls_offload *f,
 	}
 
 	err = mtk_flow_set_output_device(eth, &foe, odev, data.eth.h_dest,
-					 &wed_index);
+					 data.vlan.num, &wed_index);
 	if (err)
 		return err;
 
