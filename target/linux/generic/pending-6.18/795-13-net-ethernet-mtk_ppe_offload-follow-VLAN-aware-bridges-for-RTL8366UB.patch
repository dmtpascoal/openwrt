From: Diogo Pascoal <dmtpascoal@gmail.com>
Subject: [PATCH] net: ethernet: mtk_ppe_offload: follow VLAN-aware bridges for the RTL8366UB 802.1Q tagger

For an RTL8366UB user port in a bridge, mtk_flow_get_dsa_port() always
pushed the tag_8021q bridge VID. That matches the tagger's xmit only for
VLAN-unaware bridges. With VLAN filtering the tagger leaves the frame alone
and, because the port uses TX forwarding offload, br_handle_vlan() keeps the
real bridge VLAN on it, so the switch forwards by that VID and its
per-VLAN (IVL) FDB.

The PPE instead sent the bridge VID as the outer tag, in front of any VLAN
the flowtable pushes. Every hardware-offloaded frame then missed the FDB
and was flooded as unknown unicast to all ports of the bridge VID (leaking
it across VLANs on multi-port bridges), and the double-tagged frames grow
past 1522 bytes. Reported in the field as lost segments, duplicate ACKs and
stalls for WAN<->LAN flows over a VLAN trunk with hardware flow offloading.

For VLAN-aware bridges build the same single 802.1Q tag the software path
uses: accept a flowtable VLAN push only when that VLAN is tagged on the
port, and push the port's PVID when the bridge path marked the egress VLAN
as hardware-untagged (no push requested), provided the PVID is the only
VLAN untagged on the port. Use dsa_port_is_vlan_filtering(), which
reflects what the switch was programmed with. Anything else stays in
software.

Also refuse to bind a flow that would need more than the two VLAN tags the
PPE can insert on the standalone/VLAN-unaware paths (it silently dropped
the extra tag before), and check mtk_foe_entry_set_vlan() for the
flowtable's tags before taking a WED reference.

The flowtable does not pass the VID of a hardware-untagged egress VLAN
down to the driver, so the PVID stands in for it only when it is the one
VLAN the port sends untagged. If the port has any other egress-untagged
VLAN the flow could belong to either, and it stays in software.

Not yet verified on hardware.
---
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -11,6 +11,8 @@
 #include <net/pkt_cls.h>
 #include <net/dsa.h>
 #include <linux/dsa/8021q.h>
+#include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
 #include "mtk_eth_soc.h"
 #include "mtk_wed.h"
 
@@ -185,7 +187,8 @@ mtk_flow_mangle_ipv4(const struct flow_a
  * switch below to cover them without per-tagger review.
  */
 static int
-mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
+mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid,
+		      bool *vlan_aware)
 {
 #if IS_ENABLED(CONFIG_NET_DSA)
 	struct dsa_port *dp;
@@ -204,14 +207,26 @@ mtk_flow_get_dsa_port(struct net_device
 			*push_vid = dsa_tag_8021q_standalone_vid(dp);
 		break;
 	case DSA_TAG_PROTO_RTL8366UB_8021Q:
-		if (push_vid) {
-			struct net_device *br = dsa_port_bridge_dev_get(dp);
+		if (!push_vid)
+			break;
 
-			if (br)
-				*push_vid = dsa_tag_8021q_bridge_vid(
-					dsa_port_bridge_num_get(dp));
-			else
-				*push_vid = dsa_tag_8021q_standalone_vid(dp);
+		if (dsa_port_bridge_dev_get(dp) &&
+		    dsa_port_is_vlan_filtering(dp)) {
+			/* The tagger leaves frames for VLAN-aware bridge
+			 * ports alone and, with TX forwarding offload, the
+			 * bridge keeps their VLAN: the switch forwards them
+			 * by that VID and its per-VLAN FDB. The caller must
+			 * build the same single tag; pushing the tag_8021q
+			 * bridge VID here would make every offloaded frame
+			 * an FDB miss.
+			 */
+			if (vlan_aware)
+				*vlan_aware = true;
+		} else if (dsa_port_bridge_dev_get(dp)) {
+			*push_vid = dsa_tag_8021q_bridge_vid(
+				dsa_port_bridge_num_get(dp));
+		} else {
+			*push_vid = dsa_tag_8021q_standalone_vid(dp);
 		}
 		break;
 	default:
@@ -226,11 +241,68 @@ mtk_flow_get_dsa_port(struct net_device
 #endif
 }
 
+/* Tag a flow towards a VLAN-aware bridge port the way the software path
+ * does: exactly one 802.1Q tag carrying the egress bridge VLAN.
+ *
+ * When that VLAN is tagged on the port, the flowtable pushes it. When it
+ * is untagged there, the bridge path marks it hardware-untagged and no
+ * push is requested, so the VID is not passed down. The port's PVID then
+ * identifies it only if the PVID is the one VLAN the port sends untagged;
+ * with any other egress-untagged VLAN on the port the flow could belong
+ * to either, so it is left to software, as is anything else.
+ */
+static int
+mtk_flow_set_vlan_aware_tag(struct mtk_eth *eth, struct mtk_foe_entry *foe,
+			    struct net_device *user_dev,
+			    const struct mtk_flow_data *data)
+{
+	struct bridge_vlan_info vinfo = {};
+	bool untagged;
+	u16 vid, other;
+	int err;
+
+	if (data->vlan.num > 1)
+		return -EOPNOTSUPP;
+
+	rcu_read_lock();
+	if (data->vlan.num) {
+		vid = data->vlan.vlans[0].id;
+		untagged = false;
+	} else {
+		err = br_vlan_get_pvid_rcu(user_dev, &vid);
+		if (err || !vid) {
+			rcu_read_unlock();
+			return -EOPNOTSUPP;
+		}
+		untagged = true;
+
+		for (other = 1; other < VLAN_VID_MASK; other++) {
+			if (other == vid ||
+			    br_vlan_get_info_rcu(user_dev, other, &vinfo))
+				continue;
+			if (vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED) {
+				rcu_read_unlock();
+				return -EOPNOTSUPP;
+			}
+		}
+	}
+	err = br_vlan_get_info_rcu(user_dev, vid, &vinfo);
+	rcu_read_unlock();
+
+	if (err ||
+	    !!(vinfo.flags & BRIDGE_VLAN_INFO_UNTAGGED) != untagged)
+		return -EOPNOTSUPP;
+
+	return untagged ? mtk_foe_entry_set_vlan(eth, foe, vid) : 0;
+}
+
 static int
 mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 			   struct net_device *dev, const u8 *dest_mac,
-			   int *wed_index)
+			   const struct mtk_flow_data *data, int *wed_index)
 {
+	struct net_device *user_dev = dev;
+	bool vlan_aware = false;
 	struct mtk_wdma_info info = {};
 	struct mtk_mac *mac;
 	int pse_port, dsa_port, queue;
@@ -261,7 +333,7 @@ mtk_flow_set_output_device(struct mtk_et
 		goto out;
 	}
 
-	dsa_port = mtk_flow_get_dsa_port(&dev, &push_vid);
+	dsa_port = mtk_flow_get_dsa_port(&dev, &push_vid, &vlan_aware);
 
 	if (dev == eth->netdev[0])
 		pse_port = PSE_GDM1_PORT;
@@ -272,8 +344,16 @@ mtk_flow_set_output_device(struct mtk_et
 	else
 		return -EOPNOTSUPP;
 
-	if (dsa_port >= 0) {
+	if (dsa_port >= 0 && vlan_aware) {
+		err = mtk_flow_set_vlan_aware_tag(eth, foe, user_dev, data);
+		if (err)
+			return err;
+	} else if (dsa_port >= 0) {
 		if (push_vid) {
+			/* The PPE inserts at most two VLAN tags */
+			if (data->vlan.num >= 2)
+				return -EOPNOTSUPP;
+
 			err = mtk_foe_entry_set_vlan(eth, foe, push_vid);
 			if (err)
 				return err;
@@ -352,7 +432,7 @@ mtk_flow_offload_replace(struct mtk_eth
 			 * ppe[mac->ppe_idx]; the lookup misses and the
 			 * flow never binds in HW.
 			 */
-			mtk_flow_get_dsa_port(&idev, NULL);
+			mtk_flow_get_dsa_port(&idev, NULL, NULL);
 			if (mtk_flow_is_valid_idev(eth, idev)) {
 				struct mtk_mac *mac = netdev_priv(idev);
 
@@ -536,19 +616,22 @@ mtk_flow_offload_replace(struct mtk_eth
 	}
 
 	err = mtk_flow_set_output_device(eth, &foe, odev, data.eth.h_dest,
-					 &wed_index);
+					 &data, &wed_index);
 	if (err)
 		return err;
 
+	for (i = 0; i < data.vlan.num; i++) {
+		err = mtk_foe_entry_set_vlan(eth, &foe, data.vlan.vlans[i].id);
+		if (err)
+			return err;
+	}
+
 	if (wed_index >= 0 && (err = mtk_wed_flow_add(wed_index)) < 0)
 		return err;
 
 	if (offload_type == MTK_PPE_PKT_TYPE_BRIDGE)
 		foe.bridge.vlan = data.vlan_in;
 
-	for (i = 0; i < data.vlan.num; i++)
-		mtk_foe_entry_set_vlan(eth, &foe, data.vlan.vlans[i].id);
-
 	if (data.pppoe.num == 1)
 		mtk_foe_entry_set_pppoe(eth, &foe, data.pppoe.sid);
 
