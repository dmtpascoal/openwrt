# AmneziaWG 3.1 (kernel module, awg tool, netifd handler, LuCI page).
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y
# Kernel 6.18 made CRYPTO_LIB_CHACHA20POLY1305 and CRYPTO_LIB_CURVE25519
# promptless, so only in-kernel users can select them. CONFIG_WIREGUARD does;
# the out-of-tree amneziawg module links against both.
CONFIG_PACKAGE_kmod-wireguard=y
