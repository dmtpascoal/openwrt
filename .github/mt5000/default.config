# GL.iNet GL-MT5000 (Brume 3): base image for any user.
# Device defaults (switch driver, USB, 2.5G PHY firmware, f2fs tools) come
# from DEVICE_PACKAGES in target/linux/mediatek/image/filogic.mk.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y
CONFIG_PACKAGE_luci=y
